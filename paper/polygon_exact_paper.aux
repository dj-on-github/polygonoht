\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Datapath for the exact elliptic-arc test $2^k d^2 \le P_2\cdot \mathit  {count1}\cdot (N-\mathit  {count1})$ with $d=\mathit  {count1}-\mathit  {count11}=\mathit  {count10}$ and $P_2=\lfloor p^2 2^k\rfloor $: two subtractors, one squarer, one multiplier, one constant (CSD) multiplier, and a 35-bit comparator; the $\ll k$ block denotes the $k$-bit left shift realizing the $2^k$ scaling as wiring. The test fires once per block, so the two array multipliers may be time-shared. At $H=0.5$, $P_2=2^{k-1}$ and the constant multiplier reduces to a wire shift.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:hw}{{4}{11}{Datapath for the exact elliptic-arc test $2^k d^2 \le P_2\cdot \mathit {count1}\cdot (N-\mathit {count1})$ with $d=\mathit {count1}-\mathit {count11}=\mathit {count10}$ and $P_2=\lfloor p^2 2^k\rfloor $: two subtractors, one squarer, one multiplier, one constant (CSD) multiplier, and a 35-bit comparator; the $\ll k$ block denotes the $k$-bit left shift realizing the $2^k$ scaling as wiring. The test fires once per block, so the two array multipliers may be time-shared. At $H=0.5$, $P_2=2^{k-1}$ and the constant multiplier reduces to a wire shift}{figure.4}{}}
